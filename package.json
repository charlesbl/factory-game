{
  "name": "factory-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:invariants": "vitest run src/invariants.property.test.ts",
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "benchmark": "vitest bench --run"
  },
  "dependencies": {
    "@xyflow/react": "12.11.1",
    "dexie": "4.4.4",
    "glpk.js": "5.0.0",
    "pixi.js": "^8.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.4.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "4.8.0",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.2",
    "vitest": "4.1.9"
  }
}
