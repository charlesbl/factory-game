{
  "name": "factory-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,benchmarks,tests}/**/*.{ts,tsx,css,html}\" \"*.{ts,js,mjs,cjs}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"{src,benchmarks,tests}/**/*.{ts,tsx,css,html}\" \"*.{ts,js,mjs,cjs}\" \"scripts/**/*.mjs\"",
    "postformat": "npm run format:check",
    "lint:check": "npm run lint && npm run format:check",
    "lint:all": "npm run typecheck && npm run lint && npm run format:check",
    "check": "npm run assets:validate && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:invariants": "vitest run src/invariants.property.test.ts",
    "build": "tsc --noEmit && vite build",
    "benchmark": "vitest bench --run",
    "assets:build": "node scripts/assets/blender.mjs",
    "assets:preview": "node scripts/assets/blender.mjs --preview",
    "assets:validate": "node scripts/assets/validate_world_assets.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.11.1",
    "dexie": "4.4.4",
    "glpk.js": "5.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.4.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "4.8.0",
    "globals": "17.7.0",
    "prettier": "^3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.2",
    "vitest": "4.1.9"
  }
}
